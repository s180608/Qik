# Public backend URL only. Never put passwords/JWT secrets in EXPO_PUBLIC variables.
# iOS simulator: http://localhost:8080
# Android emulator: http://10.0.2.2:8080
# Physical phone: http://YOUR_MAC_LAN_IP:8080 (same Wi-Fi), or an HTTPS hosted backend.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Set the project IDs after creating/linking the two projects in your own Expo account.
# QIK_CUSTOMER_PROJECT_ID=
# QIK_RIDER_PROJECT_ID=
# Choose your own unique application ID prefix before store submission.
# QIK_APP_ID_PREFIX=com.yourcompany.qik
